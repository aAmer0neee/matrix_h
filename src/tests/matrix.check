#suite transpose_test

#test transpose_test1
matrix_t mtrx1;
matrix_t mtrx2;
matrix_t result;
s21_create_matrix(3, 2, &mtrx1);
s21_create_matrix(2, 3, &mtrx2);

mtrx1.matrix[0][0] = 1;
mtrx1.matrix[0][1] = 4;
mtrx1.matrix[1][0] = 2;
mtrx1.matrix[1][1] = 5;
mtrx1.matrix[2][0] = 3;
mtrx1.matrix[2][1] = 6;

mtrx2.matrix[0][0] = 1;
mtrx2.matrix[0][1] = 2;
mtrx2.matrix[0][2] = 3;
mtrx2.matrix[1][0] = 4;
mtrx2.matrix[1][1] = 5;
mtrx2.matrix[1][2] = 6;

int true_res = 0;
int s21_res = s21_transpose(&mtrx1, &result);
ck_assert_int_eq(true_res, s21_res);
ck_assert_int_eq(s21_eq_matrix(&result, &mtrx2), SUCCESS);

s21_remove_matrix(&mtrx1);
s21_remove_matrix(&mtrx2);
s21_remove_matrix(&result);

#test transpose_test2
matrix_t mtrx1;
matrix_t result;
s21_create_matrix(3, 2, &mtrx1);

int true_res = 1;
int s21_res = s21_transpose(NULL, &result);
ck_assert_int_eq(true_res, s21_res);

s21_remove_matrix(&mtrx1);

#test transpose_test3
matrix_t mtrx1;
s21_create_matrix(3, 2, &mtrx1);

int true_res = 1;
int s21_res = s21_transpose(&mtrx1, NULL);
ck_assert_int_eq(true_res, s21_res);

s21_remove_matrix(&mtrx1);

#suite calc_complements_test

#test calc_complements_test1
matrix_t mtrx;
matrix_t result;
matrix_t true_result;

s21_create_matrix(3, 3, &mtrx);
s21_create_matrix(3, 3, &true_result);

mtrx.matrix[0][0] = 1;
mtrx.matrix[0][1] = 2;
mtrx.matrix[0][2] = 3;
mtrx.matrix[1][0] = 0;
mtrx.matrix[1][1] = 4;
mtrx.matrix[1][2] = 2;
mtrx.matrix[2][0] = 5;
mtrx.matrix[2][1] = 2;
mtrx.matrix[2][2] = 1;

true_result.matrix[0][0] = 0;
true_result.matrix[0][1] = 10;
true_result.matrix[0][2] = -20;
true_result.matrix[1][0] = 4;
true_result.matrix[1][1] = -14;
true_result.matrix[1][2] = 8;
true_result.matrix[2][0] = -8;
true_result.matrix[2][1] = -2;
true_result.matrix[2][2] = 4;

int s21_res = s21_calc_complements(&mtrx, &result);
int true_res = 0;
ck_assert_int_eq(s21_res, true_res);
ck_assert_int_eq(s21_eq_matrix(&true_result, &result), SUCCESS);

s21_remove_matrix(&mtrx);
s21_remove_matrix(&result);
s21_remove_matrix(&true_result);

#test calc_complements_test2
matrix_t mtrx1;
matrix_t result;
s21_create_matrix(3, 2, &mtrx1);

int true_res = 2;
int s21_res = s21_calc_complements(&mtrx1, &result);
ck_assert_int_eq(true_res, s21_res);

s21_remove_matrix(&mtrx1);

#test calc_complements_test3
matrix_t mtrx1;
matrix_t result;
s21_create_matrix(3, 3, &mtrx1);

int true_res = 1;
int s21_res = s21_calc_complements(NULL, &result);
ck_assert_int_eq(true_res, s21_res);

s21_remove_matrix(&mtrx1);

#test calc_complements_test4
matrix_t mtrx1;
s21_create_matrix(3, 3, &mtrx1);

int true_res = 1;
int s21_res = s21_calc_complements(&mtrx1, NULL);
ck_assert_int_eq(true_res, s21_res);

s21_remove_matrix(&mtrx1);

#suite determinant_test

#test determinant_test1
matrix_t mtrx;
double result = 0;
double true_result = 0;

s21_create_matrix(3, 3, &mtrx);

mtrx.matrix[0][0] = 1;
mtrx.matrix[0][1] = 2;
mtrx.matrix[0][2] = 3;
mtrx.matrix[1][0] = 4;
mtrx.matrix[1][1] = 5;
mtrx.matrix[1][2] = 6;
mtrx.matrix[2][0] = 7;
mtrx.matrix[2][1] = 8;
mtrx.matrix[2][2] = 9;

int s21_res = s21_determinant(&mtrx, &result);
int true_res = 0;
ck_assert_int_eq(true_res, s21_res);
ck_assert_double_eq(true_result, result);

s21_remove_matrix(&mtrx);

#test determinant_test2
matrix_t mtrx;
double result;
double true_result = 234;

s21_create_matrix(1, 1, &mtrx);
mtrx.matrix[0][0] = 234;

int s21_res = s21_determinant(&mtrx, &result);
int true_res = 0;
ck_assert_int_eq(true_res, s21_res);
ck_assert_double_eq(true_result, result);

s21_remove_matrix(&mtrx);

#test determinant_test3
matrix_t mtrx;
double result;

s21_create_matrix(3, 2, &mtrx);

int s21_res = s21_determinant(&mtrx, &result);
int true_res = 2;
ck_assert_int_eq(true_res, s21_res);

s21_remove_matrix(&mtrx);

#test determinant_test4
matrix_t mtrx;
double result;

s21_create_matrix(3, 3, &mtrx);

int s21_res = s21_determinant(NULL, &result);
int true_res = 1;
ck_assert_int_eq(true_res, s21_res);

s21_remove_matrix(&mtrx);

#test determinant_test5
matrix_t mtrx;

s21_create_matrix(3, 3, &mtrx);

int s21_res = s21_determinant(&mtrx, NULL);
int true_res = 1;
ck_assert_int_eq(true_res, s21_res);

s21_remove_matrix(&mtrx);

#suite inverse_matrix

#test inverse_matrix1
matrix_t mtrx;
matrix_t result;
matrix_t true_result;

s21_create_matrix(3, 3, &mtrx);
s21_create_matrix(3, 3, &true_result);

mtrx.matrix[0][0] = 2;
mtrx.matrix[0][1] = 5;
mtrx.matrix[0][2] = 7;
mtrx.matrix[1][0] = 6;
mtrx.matrix[1][1] = 3;
mtrx.matrix[1][2] = 4;
mtrx.matrix[2][0] = 5;
mtrx.matrix[2][1] = -2;
mtrx.matrix[2][2] = -3;

true_result.matrix[0][0] = 1;
true_result.matrix[0][1] = -1;
true_result.matrix[0][2] = 1;
true_result.matrix[1][0] = -38;
true_result.matrix[1][1] = 41;
true_result.matrix[1][2] = -34;
true_result.matrix[2][0] = 27;
true_result.matrix[2][1] = -29;
true_result.matrix[2][2] = 24;

int s21_res = s21_inverse_matrix(&mtrx, &result);
int true_res = 0;
ck_assert_int_eq(s21_res, true_res);
ck_assert_int_eq(s21_eq_matrix(&true_result, &result), SUCCESS);

s21_remove_matrix(&mtrx);
s21_remove_matrix(&result);
s21_remove_matrix(&true_result);

#test inverse_matrix2
matrix_t mtrx;
matrix_t result;

s21_create_matrix(3, 3, &mtrx);

mtrx.matrix[0][0] = 1;
mtrx.matrix[0][1] = 2;
mtrx.matrix[0][2] = 3;
mtrx.matrix[1][0] = 4;
mtrx.matrix[1][1] = 5;
mtrx.matrix[1][2] = 6;
mtrx.matrix[2][0] = 7;
mtrx.matrix[2][1] = 8;
mtrx.matrix[2][2] = 9;

int s21_res = s21_inverse_matrix(&mtrx, &result);
int true_res = 2;
ck_assert_int_eq(s21_res, true_res);

s21_remove_matrix(&mtrx);

#test inverse_matrix3
matrix_t mtrx;
matrix_t result;

s21_create_matrix(2, 1, &mtrx);

int s21_res = s21_inverse_matrix(&mtrx, &result);
int true_res = 2;
ck_assert_int_eq(s21_res, true_res);

s21_remove_matrix(&mtrx);

#test inverse_matrix4
