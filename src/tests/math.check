#test sum_matrix11

matrix_t mtrx1;
matrix_t mtrx2;
matrix_t res;
matrix_t true_result;

s21_create_matrix(3, 3, &mtrx1);
s21_create_matrix(3, 3, &mtrx2);
s21_create_matrix(3, 3, &true_result);

true_result.matrix[0][0] = 9;
true_result.matrix[0][1] = 4;
true_result.matrix[0][2] = 14;
true_result.matrix[1][0] = 8;
true_result.matrix[1][1] = 0;
true_result.matrix[1][2] = 5;
true_result.matrix[2][0] = 49;
true_result.matrix[2][1] = 11;
true_result.matrix[2][2] = 3;

mtrx1.matrix[0][0] = 2;
mtrx1.matrix[0][1] = 3;
mtrx1.matrix[0][2] = 8;
mtrx1.matrix[1][0] = 5;
mtrx1.matrix[1][1] = -4;
mtrx1.matrix[1][2] = 1;
mtrx1.matrix[2][0] = 42;
mtrx1.matrix[2][1] = 2;
mtrx1.matrix[2][2] = -4;

mtrx2.matrix[0][0] = 7;
mtrx2.matrix[0][1] = 1;
mtrx2.matrix[0][2] = 6;
mtrx2.matrix[1][0] = 3;
mtrx2.matrix[1][1] = 4;
mtrx2.matrix[1][2] = 4;
mtrx2.matrix[2][0] = 7;
mtrx2.matrix[2][1] = 9;
mtrx2.matrix[2][2] = 7;

int s21_res = s21_sum_matrix(&mtrx1, &mtrx2, &res);
ck_assert_int_eq(s21_res, ERROR_OK);
ck_assert_int_eq(s21_eq_matrix(&res, &true_result), SUCCESS);

s21_remove_matrix(&mtrx1);
s21_remove_matrix(&mtrx2);
s21_remove_matrix(&true_result);
s21_remove_matrix(&res);

