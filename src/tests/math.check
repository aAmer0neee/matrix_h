#suite sum_matrix_test

#test sum_matrix1
matrix_t mtrx1;
matrix_t mtrx2;
matrix_t res;
s21_create_matrix(3, 3, &mtrx1);
s21_create_matrix(3, 3, &mtrx2);
initialize_random_matrix_int(&mtrx1);
initialize_random_matrix_double(&mtrx2);
int s21_res = s21_sum_matrix(&mtrx1, &mtrx2, &res);
ck_assert_int_eq(s21_res, ERROR_OK);

s21_remove_matrix(&mtrx1);
s21_remove_matrix(&mtrx2);
s21_remove_matrix(&res);

#test sum_matrix2
matrix_t mtrx1;
matrix_t mtrx2;
matrix_t res;
s21_create_matrix(3, 2, &mtrx1);
s21_create_matrix(3, 3, &mtrx2);
initialize_random_matrix_int(&mtrx1);
initialize_random_matrix_double(&mtrx2);
int s21_res = s21_sum_matrix(&mtrx1, &mtrx2, &res);
ck_assert_int_eq(s21_res, ERROR_CALCULATION);

s21_remove_matrix(&mtrx1);
s21_remove_matrix(&mtrx2);

